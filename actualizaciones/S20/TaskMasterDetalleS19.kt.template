package com.itcancun.mjdzul.taskmaster

import android.app.Activity
import android.graphics.drawable.GradientDrawable
import android.widget.TextView

/** Vista de detalle compatible con datos anteriores y esquema JSON v2. */
fun Activity.configurarDetalleVisualS19() {
    val raw = intent.getStringExtra(DetalleActivity.EXTRA_TAREA).orEmpty().trim()
    val partes = raw.removePrefix("★ ").split(" | ")
    val titulo = intent.getStringExtra("tmpro_nombre")
        ?: partes.firstOrNull()?.trim().orEmpty().ifBlank { "Tarea sin nombre" }
    val categoria = intent.getStringExtra("tmpro_categoria")
        ?: partes.getOrNull(1)?.trim().orEmpty().ifBlank { "Sin categoría" }
    val prioridad = intent.getStringExtra("tmpro_prioridad")
        ?: Regex("Prioridad:\\s*(Alta|Media|Baja)", RegexOption.IGNORE_CASE)
            .find(raw)?.groupValues?.get(1)?.replaceFirstChar { it.uppercase() } ?: "Media"
    val importante = intent.getBooleanExtra("tmpro_importante", raw.startsWith("★ "))
    val fecha = intent.getStringExtra("tmpro_fecha").orEmpty()

    findViewById<TextView>(R.id.tvDetalleTarea).text = titulo
    findViewById<TextView>(R.id.tvDetalleCategoriaResumen).text = categoria
    findViewById<TextView>(R.id.tvDetalleCategoria).text = categoria
    val vistaPrioridad = findViewById<TextView>(R.id.tvDetallePrioridad)
    vistaPrioridad.text = prioridad
    val (colorFondo, colorTexto) = when (prioridad.lowercase()) {
        "alta" -> 0xFFFFD9DE.toInt() to 0xFFC11936.toInt()
        "baja" -> 0xFFD8F7E2.toInt() to 0xFF167243.toInt()
        else -> 0xFFFFE8BD.toInt() to 0xFF915C00.toInt()
    }
    vistaPrioridad.setTextColor(colorTexto)
    vistaPrioridad.background = GradientDrawable().apply {
        cornerRadius = 13f * resources.displayMetrics.density
        setColor(colorFondo)
    }
    val vistaImportante = findViewById<TextView>(R.id.tvDetalleImportante)
    vistaImportante.text = if (importante) "Sí" else "No"
    if (!importante) {
        vistaImportante.setTextColor(0xFF5E6171.toInt())
        vistaImportante.background = GradientDrawable().apply {
            cornerRadius = 13f * resources.displayMetrics.density
            setColor(0xFFE9EAF0.toInt())
        }
    }
    findViewById<TextView>(R.id.tvDetalleFechaPro).text =
        fecha.ifBlank { "Sin asignar (tarea anterior)" }
}
