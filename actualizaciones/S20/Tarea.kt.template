package com.itcancun.mjdzul.taskmaster

import org.json.JSONObject
import java.util.UUID

/** Modelo único de TaskMaster Pro. La fecha es nula solo en tareas heredadas. */
data class Tarea(
    val id: String = UUID.randomUUID().toString(),
    val nombre: String,
    val categoria: String,
    val prioridad: String,
    val importante: Boolean,
    val fechaProgramada: String? = null,
    val completada: Boolean = false,
    val textoOriginal: String? = null
) {
    fun aJson(): JSONObject = JSONObject().apply {
        put("id", id)
        put("nombre", nombre)
        put("categoria", categoria)
        put("prioridad", prioridad)
        put("importante", importante)
        put("fechaProgramada", fechaProgramada ?: JSONObject.NULL)
        put("completada", completada)
        if (textoOriginal != null) put("textoOriginal", textoOriginal)
    }

    /** Compatibilidad con DetalleActivity.EXTRA_TAREA de sesiones previas. */
    fun textoLegado(): String =
        (if (importante) "★ " else "") + "$nombre | $categoria | Prioridad: $prioridad"

    companion object {
        fun desdeJson(json: JSONObject): Tarea {
            val fecha = if (json.isNull("fechaProgramada")) null
                else json.optString("fechaProgramada").ifBlank { null }
            return Tarea(
                id = json.optString("id").ifBlank { UUID.randomUUID().toString() },
                nombre = json.getString("nombre"),
                categoria = json.optString("categoria", "Otra"),
                prioridad = json.optString("prioridad", "Media"),
                importante = json.optBoolean("importante", false),
                fechaProgramada = fecha,
                completada = json.optBoolean("completada", false),
                textoOriginal = if (json.has("textoOriginal") && !json.isNull("textoOriginal"))
                    json.getString("textoOriginal") else null
            )
        }

        /** Convierte cada elemento del arreglo antiguo sin descartar el texto fuente. */
        fun desdeLegado(texto: String): Tarea {
            val importante = texto.startsWith("★ ")
            val partes = texto.removePrefix("★ ").split(" | ")
            val nombre = partes.firstOrNull().orEmpty().trim().ifBlank { "Tarea sin título" }
            val categoria = partes.getOrNull(1).orEmpty().trim().ifBlank { "Otra" }
            val prioridad = Regex("Prioridad:\\s*(Alta|Media|Baja)", RegexOption.IGNORE_CASE)
                .find(texto)?.groupValues?.get(1)?.lowercase()?.replaceFirstChar { it.uppercase() } ?: "Media"
            return Tarea(
                nombre = nombre,
                categoria = categoria,
                prioridad = prioridad,
                importante = importante,
                fechaProgramada = null,
                textoOriginal = texto
            )
        }
    }
}
