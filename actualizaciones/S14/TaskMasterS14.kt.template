package __PACKAGE__

import android.app.Activity
import android.widget.ArrayAdapter
import android.widget.Button
import android.widget.CheckBox
import android.widget.EditText
import android.widget.ImageButton
import android.widget.ListView
import android.widget.RadioGroup
import android.widget.Spinner
import android.widget.TextView
import android.widget.Toast

/**
 * Sesión 14: formulario funcional de TaskMaster.
 * Se invoca UNA SOLA VEZ desde MainActivity.onCreate(), después de setContentView().
 * Conserva los controles XML de S12 y sustituye la configuración de eventos de S13.
 * Las tareas solo están en memoria: se pierden al recrear la Activity.
 */
fun Activity.configurarTaskMasterS14() {
    // 1. Obtener los controles que ya existen en activity_main.xml (S12).
    val campoTarea = findViewById<EditText>(R.id.etNombreTarea)
    val botonAgregar = findViewById<Button>(R.id.btnAgregarTarea)
    val listaVisual = findViewById<ListView>(R.id.lvTareas)
    val grupoPrioridad = findViewById<RadioGroup>(R.id.rgPrioridad)
    val categoria = findViewById<Spinner>(R.id.spCategoria)
    val importante = findViewById<CheckBox>(R.id.cbRecordatorio)
    val botonEliminar = findViewById<ImageButton>(R.id.ibEliminarEjemplo)
    val tituloLista = findViewById<TextView>(R.id.tvListaEtiqueta)
    val nota = findViewById<TextView>(R.id.tvNota)

    // 2. Conservar las tareas de ejemplo y preparar la lista visible.
    val tareas = resources.getStringArray(R.array.tareas_ejemplo_taskmaster_s12)
        .toMutableList()
    val adaptador = ArrayAdapter(
        this,
        android.R.layout.simple_list_item_activated_1,
        tareas
    )
    listaVisual.adapter = adaptador
    listaVisual.choiceMode = ListView.CHOICE_MODE_SINGLE
    tituloLista.text = "Mis tareas"
    nota.text = "S14: agrega tareas completas; toca una tarea y usa la papelera para eliminarla."

    // 3. Seleccionar una tarea de la lista para poder eliminarla.
    var posicionSeleccionada = -1
    listaVisual.setOnItemClickListener { _, _, posicion, _ ->
        posicionSeleccionada = posicion
        listaVisual.setItemChecked(posicion, true)
    }

    // 4. Leer, validar y registrar tareas con sus opciones.
    botonAgregar.setOnClickListener {
        val nombre = campoTarea.text.toString().trim()
        if (nombre.isBlank()) {
            campoTarea.error = "Escribe el nombre de la tarea"
            Toast.makeText(this, "No puedes agregar una tarea vacía", Toast.LENGTH_SHORT).show()
        } else {
            val prioridad = when (grupoPrioridad.checkedRadioButtonId) {
                R.id.rbAlta -> "Alta"
                R.id.rbBaja -> "Baja"
                else -> "Media"
            }
            val tipo = categoria.selectedItem?.toString() ?: "Otra"
            val marca = if (importante.isChecked) "★ " else ""
            val descripcion = "$marca$nombre | $tipo | Prioridad: $prioridad"

            tareas.add(descripcion)
            adaptador.notifyDataSetChanged()
            posicionSeleccionada = -1
            listaVisual.clearChoices()
            adaptador.notifyDataSetChanged()

            campoTarea.text.clear()
            grupoPrioridad.check(R.id.rbMedia)
            categoria.setSelection(0)
            importante.isChecked = false
            Toast.makeText(this, "Tarea agregada", Toast.LENGTH_SHORT).show()
        }
    }

    // 5. Eliminar SOLO la tarea seleccionada y actualizar la lista.
    botonEliminar.setOnClickListener {
        if (posicionSeleccionada !in tareas.indices) {
            Toast.makeText(this, "Selecciona una tarea para eliminar", Toast.LENGTH_SHORT).show()
        } else {
            tareas.removeAt(posicionSeleccionada)
            posicionSeleccionada = -1
            listaVisual.clearChoices()
            adaptador.notifyDataSetChanged()
            Toast.makeText(this, "Tarea eliminada", Toast.LENGTH_SHORT).show()
        }
    }
}
