<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F2F6FA">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TASKMASTER · S17"
            android:textColor="#126C72"
            android:textStyle="bold"
            android:textSize="14sp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Detalle de tarea"
            android:textColor="#142C43"
            android:textStyle="bold"
            android:textSize="28sp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Consulta la tarea que seleccionaste en la pantalla principal."
            android:textColor="#4C647A"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/tvDetalleTarea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="#FFFFFF"
            android:elevation="2dp"
            android:padding="20dp"
            android:text="Información de la tarea"
            android:textColor="#142C43"
            android:textSize="18sp" />
        <Button
            android:id="@+id/btnVolverTareas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Volver a mis tareas" />
    </LinearLayout>
</ScrollView>
