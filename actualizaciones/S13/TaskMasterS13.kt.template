package __PACKAGE__

import android.app.Activity
import android.widget.ArrayAdapter
import android.widget.Button
import android.widget.EditText
import android.widget.ListView
import android.widget.TextView
import android.widget.Toast

/**
 * S13: evento, captura, validación y actualización de ListView.
 * Se llama UNA SOLA VEZ desde MainActivity.onCreate(), después de setContentView().
 * La lista se conserva únicamente en memoria mientras se ejecuta la Activity.
 */
fun Activity.configurarTaskMasterS13() {
    val campoTarea = findViewById<EditText>(R.id.etNombreTarea)
    val botonAgregar = findViewById<Button>(R.id.btnAgregarTarea)
    val listaVisual = findViewById<ListView>(R.id.lvTareas)
    val tituloLista = findViewById<TextView>(R.id.tvListaEtiqueta)
    val nota = findViewById<TextView>(R.id.tvNota)

    // Se conservan las tres tareas de muestra que ya aparecían en S12.
    val tareas = resources.getStringArray(R.array.tareas_ejemplo_taskmaster_s12)
        .toMutableList()

    val adaptador = ArrayAdapter(this, android.R.layout.simple_list_item_1, tareas)
    listaVisual.adapter = adaptador
    tituloLista.text = "Mis tareas"
    nota.text = "S13: escribe una tarea y presiona Agregar tarea."

    botonAgregar.setOnClickListener {
        val nombre = campoTarea.text.toString().trim()
        if (nombre.isBlank()) {
            campoTarea.error = "Escribe el nombre de la tarea"
            Toast.makeText(this, "No puedes agregar una tarea vacía", Toast.LENGTH_SHORT).show()
        } else {
            tareas.add(nombre)
            adaptador.notifyDataSetChanged()
            campoTarea.text.clear()
            Toast.makeText(this, "Tarea agregada", Toast.LENGTH_SHORT).show()
        }
    }
}
